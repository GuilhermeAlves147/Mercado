              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"lista com ao menos 55 produtos (carga)\", () => { pm.expect(j).to.be.an(\"array\"); pm.expect(j.length).to.be.at.least(55); });",
                  "const p = j.find(x => x.quantity >= 5);",
                  "pm.test(\"existe produto com estoque para os testes de carrinho\", () => pm.expect(p).to.not.be.undefined);",
                  "if (p) { pm.collectionVariables.set(\"stockProductId\", p.id); pm.collectionVariables.set(\"stockBefore\", p.quantity); }"
                ]
              }
            }
          ],
